        <th rowspan="2" style="background:var(--bg2);border-bottom:0.5px solid var(--border)">Liste</th>
        <th colspan="4" class="sep">Portföy</th>
        <th colspan="3" class="sep">Teknik</th>
        <th colspan="4" class="sep">Fiyat Aralığı (20g)</th>
