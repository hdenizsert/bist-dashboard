<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BIST Portföy Dashboard</title>
<style>
  :root {
    --bg: #ffffff; --bg2: #f5f5f3; --bg3: #efefec;
    --text: #1a1a18; --text2: #6b6b67; --text3: #9b9b96;
    --border: rgba(0,0,0,0.1); --border2: rgba(0,0,0,0.2);
    --pos: #0F6E56; --neg: #A32D2D;
    --info: #185FA5; --warn: #BA7517;
    --radius: 8px; --radius-lg: 12px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1e1e1c; --bg2: #2a2a28; --bg3: #333330;
      --text: #f0ede8; --text2: #a8a8a3; --text3: #6b6b67;
      --border: rgba(255,255,255,0.1); --border2: rgba(255,255,255,0.2);
    }
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
         font-size: 13px; background: var(--bg3); color: var(--text); min-height: 100vh; }
  .page { max-width: 1400px; margin: 0 auto; padding: 1.5rem 1rem; }
  header { margin-bottom: 1.25rem; }
  header h1 { font-size: 18px; font-weight: 500; color: var(--text); }
  header p  { font-size: 11px; color: var(--text3); margin-top: 3px; }
  .metrics { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; margin-bottom: 1.25rem; }
  .mc { background: var(--bg); border: 0.5px solid var(--border); border-radius: var(--radius);
        padding: 10px 14px; }
  .mc .lbl { font-size: 10px; color: var(--text2); margin-bottom: 4px; text-transform: uppercase; letter-spacing: .04em; }
  .mc .val { font-size: 22px; font-weight: 500; }
  .mc .sub { font-size: 10px; color: var(--text3); margin-top: 2px; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 1rem; align-items: center; }
  .filters label { font-size: 10px; color: var(--text2); font-weight: 500; }
  .div { width: 1px; height: 16px; background: var(--border); margin: 0 2px; }
  .fbtn { font-size: 10px; padding: 3px 10px; border: 0.5px solid var(--border2);
          border-radius: 20px; background: transparent; color: var(--text2);
          cursor: pointer; transition: all .12s; }
  .fbtn:hover { background: var(--bg2); }
  .fbtn.active { background: var(--text); color: var(--bg); border-color: var(--text); }
  .tbwrap { overflow-x: auto; border: 0.5px solid var(--border);
            border-radius: var(--radius-lg); background: var(--bg); }
  table { border-collapse: collapse; width: max-content; min-width: 100%; }
  thead tr:first-child th { font-size: 9px; font-weight: 500; color: var(--text3);
    text-transform: uppercase; letter-spacing: .04em; padding: 5px 7px 2px;
    background: var(--bg2); border-bottom: none; white-space: nowrap; text-align: center; }
  thead tr:last-child th { font-size: 9px; font-weight: 500; color: var(--text2);
    text-transform: uppercase; padding: 3px 7px 5px; background: var(--bg2);
    border-bottom: 0.5px solid var(--border); white-space: nowrap; }
  th.sep, td.sep { border-left: 1.5px solid var(--border2); }
  td { padding: 5px 7px; border-bottom: 0.5px solid var(--border); vertical-align: middle; white-space: nowrap; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--bg2); }
  .tk { font-weight: 500; }
  .sec { font-size: 9px; color: var(--text3); display: block; margin-top: 1px; }
  .badge { display: inline-block; font-size: 9px; font-weight: 500; padding: 1px 6px; border-radius: 20px; }
  .b-sat { background: #FCEBEB; color: #501313; }
  .b-tut { background: #F1EFE8; color: #2C2C2A; }
  .b-karal { background: #E1F5EE; color: #04342C; }
  .b-haz { background: #E6F1FB; color: #042C53; }
  .b-yok { background: #F1EFE8; color: #888780; }
  .pos { color: var(--pos); } .neg { color: var(--neg); }
  .rsi-wrap { display: flex; align-items: center; gap: 4px; }
  .rsi-bar { height: 4px; border-radius: 2px; }
  .stop-wrap { display: flex; align-items: center; gap: 4px; }
  .stop-bar { height: 4px; border-radius: 2px; }
  .sig-izle { color: var(--info); font-size: 9px; font-weight: 500; }
  .sig-bekle { color: var(--text3); font-size: 9px; }
  .tarih { display: inline-block; font-size: 11px; background: var(--bg2);
           border: 0.5px solid var(--border); color: var(--text2);
           padding: 3px 10px; border-radius: var(--radius); margin-bottom: 1rem; }
  .legend { font-size: 10px; color: var(--text3); margin-top: 8px; display: flex; flex-wrap: wrap; gap: 10px; }
  .empty { text-align: center; padding: 2rem; color: var(--text3); }
  @media(max-width:600px){ .metrics{grid-template-columns:repeat(2,1fr);} }
</style>
</head>
