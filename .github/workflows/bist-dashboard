const filters={liste:'all',oneri:'all',sinyal:'all'};
const ob={TUT:'b-tut','İZLE/HAZIRLAN':'b-haz','KAR AL':'b-karal',SAT:'b-sat','—':'b-yok'};

function f(n,d=2){return n!=null?n.toLocaleString('tr-TR',{minimumFractionDigits:d,maximumFractionDigits:d}):'—';}

function rsiCell(v){
  if(v==null)return '—';
  const c=v>70?'#E24B4A':v<35?'#1D9E75':'#378ADD';
  const tc=v>70?'#A32D2D':v<35?'#0F6E56':'var(--text2)';
  return `<div class="rsi-wrap"><div class="rsi-bar" style="width:${Math.min(v/100*38,38).toFixed(0)}px;background:${c}"></div><span style="font-size:10px;color:${tc}">${v.toFixed(1)}</span></div>`;
}
function stopCell(fiyat,stop){
  if(!stop)return '—';
  const pct=(fiyat-stop)/fiyat*100;
  const c=pct<5?'#E24B4A':pct<10?'#BA7517':'#1D9E75';
  return `<div class="stop-wrap"><div class="stop-bar" style="width:${Math.min(pct/20*32,32).toFixed(0)}px;background:${c}"></div><span style="font-size:10px;color:${c}">-${pct.toFixed(1)}%</span></div>`;
}

function render(){
  const rows=DATA.filter(d=>{
    if(filters.liste!=='all'&&d.l!==filters.liste)return false;
    if(filters.oneri!=='all'&&d.o!==filters.oneri)return false;
    if(filters.sinyal!=='all'&&d.sig!==filters.sinyal)return false;
    return true;
  });
  const portfoy=rows.filter(d=>d.l==='Portföy');
  const totVal=portfoy.reduce((s,d)=>s+(d.f*(d.adet||0)),0);
  const totKZ=portfoy.reduce((s,d)=>s+(d.kzTL||0),0);
  document.getElementById('m-val').textContent=f(totVal,0)+' ₺';
  const kzEl=document.getElementById('m-kz');
  kzEl.textContent=(totKZ>=0?'+':'')+f(totKZ)+' ₺';
  kzEl.style.color=totKZ>=0?'var(--pos)':'var(--neg)';
  document.getElementById('m-izle').textContent=rows.filter(d=>d.o==='İZLE/HAZIRLAN').length;
  document.getElementById('m-aksiyon').textContent=rows.filter(d=>d.o==='SAT'||d.o==='KAR AL').length;
  document.getElementById('tarih-badge').textContent='Veri: 05.05.2026 — yfinance';

  const tb=document.getElementById('tb');
  if(!rows.length){tb.innerHTML='<tr><td colspan="22" class="empty">Sonuç bulunamadı</td></tr>';return;}
  tb.innerHTML=rows.map(d=>{
    const lTag=d.l==='Portföy'?'<span style="color:#A32D2D;font-size:10px;font-weight:500">P</span>':'<span style="color:#185FA5;font-size:10px;font-weight:500">M</span>';
    const sig=d.sig==='İZLE'?'<span class="sig-izle">İZLE</span>':'<span class="sig-bekle">BEKLE</span>';
    const rowBg=d.o==='SAT'?'background:rgba(162,45,45,0.04)':d.sig==='İZLE'?'background:rgba(24,95,165,0.04)':'';
    return `<tr style="${rowBg}">
      <td class="tk">${d.t}<span class="sec">${d.s}</span></td>
      <td style="text-align:center">${lTag}</td>
      <td class="sep" style="color:var(--text2)">${d.alis!=null?f(d.alis):'—'}</td>
      <td>${d.adet!=null?d.adet:'—'}</td>
      <td class="${d.kzTL!=null?(d.kzTL>=0?'pos':'neg'):''}">${d.kzTL!=null?(d.kzTL>=0?'+':'')+f(d.kzTL):'—'}</td>
      <td class="${d.kzPct!=null?(d.kzPct>=0?'pos':'neg'):''}">${d.kzPct!=null?(d.kzPct>=0?'+':'')+f(Math.abs(d.kzPct))+'%':'—'}</td>
      <td class="sep" style="font-weight:500">${f(d.f)}</td>
      <td>${rsiCell(d.rsi)}</td>
      <td style="text-align:center;font-size:12px;color:${d.macd==='✓'?'#1D9E75':'#E24B4A'}">${d.macd}</td>
      <td class="sep" style="color:var(--text2)">${f(d.des20)}</td>
      <td style="color:var(--text2)">${f(d.dir20)}</td>
      <td style="color:var(--text3);font-size:10px">${f(d.des1y)}</td>
      <td style="color:var(--text3);font-size:10px">${f(d.dir1y)}</td>
      <td class="sep" style="color:#1D9E75;font-size:10px">${f(d.bbA)}</td>
      <td style="color:#E24B4A;font-size:10px">${f(d.bbU)}</td>
      <td class="sep" style="color:var(--text2);font-size:10px">${f(d.alA)}</td>
      <td style="color:var(--text2);font-size:10px">${f(d.saA)}</td>
      <td style="color:#A32D2D;font-size:10px">${f(d.stop)}</td>
      <td>${stopCell(d.f,d.stop)}</td>
      <td class="sep" style="color:#0F6E56;font-size:10px">${f(d.ka)}</td>
      <td class="sep"><span class="badge ${ob[d.o]||'b-yok'}">${d.o}</span> ${sig}</td>
    </tr>`;
  }).join('');
}

function setF(key,val,btn){
  filters[key]=val;
  const grp=btn.dataset.g;
  if(grp) document.querySelectorAll(`[data-g="${grp}"]`).forEach(b=>b.classList.remove('active'));
  else document.querySelectorAll('.fbtn:not([data-g])').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active'); render();
}
render();
</script>
</body>
</html>
